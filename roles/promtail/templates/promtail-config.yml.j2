server:
  http_listen_port: 9080

positions:
  filename: /tmp/positions.yaml

clients:
  - url: {{ loki_url }}

scrape_configs:
  - job_name: syslog
    static_configs:
      - targets: [localhost]
        labels:
          job: syslog
          host: {{ inventory_hostname }}
          __path__: {{ '/var/log/messages' if ansible_os_family == 'RedHat' else '/var/log/syslog' }}

  - job_name: auth
    static_configs:
      - targets: [localhost]
        labels:
          job: auth
          host: {{ inventory_hostname }}
          __path__: {{ '/var/log/secure' if ansible_os_family == 'RedHat' else '/var/log/auth.log' }}

  - job_name: nginx
    static_configs:
      - targets: [localhost]
        labels:
          job: nginx
          host: {{ inventory_hostname }}
          __path__: /var/log/nginx/*.log

  - job_name: fail2ban
    static_configs:
      - targets: [localhost]
        labels:
          job: fail2ban
          host: {{ inventory_hostname }}
          __path__: /var/log/fail2ban.log
